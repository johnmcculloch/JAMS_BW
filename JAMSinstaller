#!/usr/bin/env Rscript
#############################################################################################
## JAMSinstaller - installs the JAMS R package and its dependencies on any system.
##
## Works on:
##   * HPC clusters (Slurm, PBS/Torque, SGE, LSF) and stand-alone Linux servers, for running JAMSalpha/JAMSbeta;
##   * Linux and macOS (Intel and Apple silicon) laptops/desktops;
##   * Windows laptops (R package only, for loading and plotting a JAMSbeta workspace sent by a colleague).
##
## Usage (Linux/macOS terminal):
##   Rscript JAMSinstaller --install [options]
##
## Usage (Windows, or from inside R/RStudio on any OS):
##   setwd("path/to/JAMS_BW")
##   source("JAMSinstaller")                       #installs with the defaults for your system
##   #To pass options when sourcing, first define e.g.
##   #JAMS_INSTALL_ARGS <- c("--install", "--profile", "minimal")
##
## The list of R dependencies is read from the DESCRIPTION file of the JAMS clone this script lives in,
## so this script never needs editing when dependencies change:
##   Depends + Imports  -> required; installation stops if any of them fails.
##   Suggests           -> optional; failures are reported but do not stop the installation.
## Base R only is used until BiocManager/remotes are installed: we do not know yet what the user has.
#############################################################################################

print_help <- function(){
    cat("JAMSinstaller - installs the JAMS package and its dependencies on your system.\n")
    cat("Instructions: https://github.com/johnmcculloch/JAMS_BW/wiki\n\n")
    cat("Usage: Rscript JAMSinstaller --install [options]\n\n")
    cat("Options:\n")
    cat("  --install               Required to actually install (otherwise this help is shown).\n")
    cat("  --profile <name>        What to install. One of:\n")
    cat("                            minimal : JAMS + required dependencies only.\n")
    cat("                            beta    : minimal + optional plotting extras (tSNE, word clouds, taxonomy trees,\n")
    cat("                                      interactive colour editor). Default on macOS and Windows.\n")
    cat("                            full    : beta + dada2/DECIPHER (JAMS16). Default on Linux.\n")
    cat("  --lib <path>            R library to install into. Default: the first writable library in .libPaths(),\n")
    cat("                          otherwise your personal library (R_LIBS_USER), which is created if needed.\n")
    cat("  --linkto <path>         Folder in which to create symbolic links to the JAMS executables (Linux/macOS only).\n")
    cat("                          Default: ~/bin (created if absent). Use --no-links to skip.\n")
    cat("  --no-links              Do not create symbolic links to the JAMS executables.\n")
    cat("  --bioc-version <x.y>    Pin a Bioconductor release (e.g. 3.23). Default: the release that matches your R,\n")
    cat("                          as chosen by BiocManager. Only pin if you know you need to.\n")
    cat("  --no-update             Do not update outdated packages of JAMS's dependency tree that are in the target\n")
    cat("                          library (other packages and shared site libraries are never touched).\n")
    cat("  --rebuild-stale         Rebuild, inside the target library, packages JAMS needs that were built for a different\n")
    cat("                          R version. Without it the installer stops and explains the options instead.\n")
    cat("  --force                 Reinstall dependencies even if they are already installed.\n")
    cat("  --dry-run               Show what would be done, without installing anything.\n")
    cat("  --help                  Show this help.\n\n")
    cat("Environment variables understood by JAMS at run time: JAMS_THREADS and JAMS_MEMORY_GB override the\n")
    cat("detected number of CPUs and amount of RAM (useful on shared servers without a job scheduler).\n")
}

##########################
## Parse the arguments  ##
##########################
if (exists("JAMS_INSTALL_ARGS", envir = globalenv())){
    args <- as.character(get("JAMS_INSTALL_ARGS", envir = globalenv()))
} else {
    args <- commandArgs(trailingOnly = TRUE)
    #When source()d interactively (e.g. on Windows) there are no command line arguments: use the defaults.
    if ((length(args) == 0) && interactive()){
        args <- "--install"
    }
}

flags_without_value <- c("--install", "--no-links", "--no-update", "--rebuild-stale", "--force", "--dry-run", "--help", "-h", "--onlybeta")
flags_with_value <- c("--profile", "--lib", "--linkto", "--bioc-version")
opts <- list()
i <- 1
while (i <= length(args)){
    a <- args[i]
    if (a %in% flags_with_value){
        if ((i == length(args)) || startsWith(args[i + 1], "--")){
            stop(paste("Option", a, "needs a value. Run with --help for usage."))
        }
        opts[[a]] <- args[i + 1]
        i <- i + 2
    } else if (a %in% flags_without_value){
        opts[[a]] <- TRUE
        i <- i + 1
    } else {
        cat(paste0("Unknown option: ", a, "\n\n"))
        print_help()
        stop("Unknown option.", call. = FALSE)
    }
}

if (is.null(opts[["--install"]]) || !is.null(opts[["--help"]]) || !is.null(opts[["-h"]])){
    print_help()
    #quit() would close an interactive R session; only use it under Rscript.
    if (interactive()) {
        stop("Nothing installed. Run with --install.", call. = FALSE)
    } else {
        quit(save = "no", status = 0)
    }
}

#Backwards compatibility with the old JAMSinstaller_BW option
if (!is.null(opts[["--onlybeta"]]) && is.null(opts[["--profile"]])){
    opts[["--profile"]] <- "beta"
}

dry_run <- !is.null(opts[["--dry-run"]])
update_old <- is.null(opts[["--no-update"]])
force_install <- !is.null(opts[["--force"]])

say <- function(...){
    cat(paste0("[JAMSinstaller] ", paste0(...), "\n"))
}
rule <- function(title){
    cat(paste0("\n==== ", title, " ", strrep("=", max(3, 70 - nchar(title))), "\n"))
}

#########################################
## Where is JAMS, and what system is it ##
#########################################
getScriptPath <- function(){
    #source()d (from R, RStudio, or the JAMSinstaller_BW shim): the innermost source() call knows the file name.
    for (fr in rev(sys.frames())){
        if (!is.null(fr$ofile)){
            return(dirname(normalizePath(fr$ofile)))
        }
    }
    #Run with Rscript
    cmdArgs <- commandArgs(trailingOnly = FALSE)
    needle <- "--file="
    hit <- grep(needle, cmdArgs, fixed = TRUE)
    if (length(hit) > 0){
        #Rscript encodes spaces in the script path as ~+~
        return(dirname(normalizePath(gsub("~+~", " ", sub(needle, "", cmdArgs[hit[1]], fixed = TRUE), fixed = TRUE))))
    }
    return(normalizePath(getwd()))
}

jamsdir <- getScriptPath()
if (!file.exists(file.path(jamsdir, "DESCRIPTION"))){
    stop(paste("Could not find the JAMS DESCRIPTION file in", jamsdir, "- run this script from inside your JAMS_BW folder."))
}
jamsdesc <- read.dcf(file.path(jamsdir, "DESCRIPTION"))
jams_version <- unname(jamsdesc[1, "Version"])

os_type <- .Platform$OS.type
sysname <- Sys.info()[["sysname"]]
on_windows <- (os_type == "windows")
on_mac <- (sysname == "Darwin")
on_linux <- (sysname == "Linux")

rule(paste("Installing JAMS", jams_version))
say("JAMS source folder: ", jamsdir)
say("Operating system: ", sysname, " ", Sys.info()[["release"]], " (", Sys.info()[["machine"]], ")")
say("R: ", R.version.string, " (", R.version$arch, ")")

#R version. The DESCRIPTION file holds the hard minimum.
r_min <- "4.3.0"
dep_field <- if ("Depends" %in% colnames(jamsdesc)) jamsdesc[1, "Depends"] else ""
r_min_hit <- regmatches(dep_field, regexpr("R \\(>= *[0-9.]+\\)", dep_field))
if (length(r_min_hit) == 1){
    r_min <- gsub("[^0-9.]", "", sub("^R", "", r_min_hit))
}
if (getRversion() < r_min){
    stop(paste0("JAMS needs R >= ", r_min, ". You have ", getRversion(), ". Please update R (https://cran.r-project.org) and try again."))
}
if (getRversion() < "4.5.0"){
    say("NOTE: R ", getRversion(), " works, but the Bioconductor release for it is frozen. R 4.5 or newer is recommended.")
}

#macOS: warn if an Intel build of R is running under Rosetta on Apple silicon (slow, and different binaries).
if (on_mac && (R.version$arch != "aarch64")){
    translated <- tryCatch(suppressWarnings(system2("sysctl", c("-n", "sysctl.proc_translated"), stdout = TRUE, stderr = FALSE)), error = function(e) character(0))
    if ((length(translated) > 0) && identical(trimws(translated[1]), "1")){
        say("WARNING: this Mac has an Apple silicon processor but you are running the Intel build of R under Rosetta.")
        say("         It will work, but installing the arm64 ('Apple silicon') build of R from CRAN is much faster.")
    }
}

#Job scheduler (informational only; JAMS::detectHardwareResources() deals with this at run time)
scheduler <- "none"
if (nzchar(Sys.getenv("SLURM_JOB_ID"))) {
    scheduler <- "Slurm"
} else if (nzchar(Sys.getenv("PBS_JOBID"))) {
    scheduler <- "PBS/Torque"
} else if (nzchar(Sys.getenv("JOB_ID")) && nzchar(Sys.getenv("SGE_ROOT"))) {
    scheduler <- "SGE/UGE"
} else if (nzchar(Sys.getenv("LSB_JOBID"))) {
    scheduler <- "LSF"
}
say("Inside a batch job: ", ifelse(scheduler == "none", "no", scheduler))

#Profile
profile <- opts[["--profile"]]
if (is.null(profile)){
    profile <- if (on_linux) "full" else "beta"
}
profile <- tolower(profile)
if (!(profile %in% c("minimal", "beta", "full"))){
    stop("--profile must be one of minimal, beta or full.")
}
if (on_windows && (profile == "full")){
    say("NOTE: JAMSalpha and JAMS16 need a Unix system. On Windows the 'beta' profile is used instead of 'full'.")
    profile <- "beta"
}
say("Installation profile: ", profile)

#########################
## R library location  ##
#########################
#file.access() ignores folder permissions on Windows, so actually try to create something (as install.packages does).
is_writable <- function(path){
    if (!dir.exists(path)){
        return(FALSE)
    }
    probe <- file.path(path, paste0("_jams_write_test_", Sys.getpid()))
    ok <- suppressWarnings(dir.create(probe, showWarnings = FALSE))
    if (ok){
        unlink(probe, recursive = TRUE)
    }
    ok
}
r_libs_user <- strsplit(Sys.getenv("R_LIBS_USER"), .Platform$path.sep)[[1]]
r_libs_user <- if (length(r_libs_user) > 0) path.expand(r_libs_user[1]) else ""
orig_libpaths <- normalizePath(.libPaths(), mustWork = FALSE)
rlib <- opts[["--lib"]]
if (is.null(rlib)){
    #Like install.packages(): the first library in .libPaths() that we can really write to (personal, site,
    #conda env or R's own library), otherwise the personal library R_LIBS_USER, created if needed.
    candidates <- .libPaths()
    writable <- candidates[vapply(candidates, is_writable, logical(1))]
    if (length(writable) > 0){
        rlib <- writable[1]
    } else if (nzchar(r_libs_user)){
        rlib <- r_libs_user
    } else {
        rlib <- file.path(Sys.getenv("HOME"), "R", "library")
    }
}
rlib <- path.expand(rlib)
if (!dir.exists(rlib) && !dry_run){
    dir.create(rlib, recursive = TRUE, showWarnings = FALSE)
}
if (!dry_run && !is_writable(rlib)){
    stop(paste("Cannot write to the R library", rlib, "- choose another one with --lib <path>."))
}
#Put the target library first so every installer below (BiocManager, remotes) writes there.
.libPaths(unique(c(rlib, .libPaths())))
say("R packages will be installed to: ", rlib)
#Warn if future R sessions will not look in this library by themselves.
default_libs <- c(orig_libpaths, normalizePath(r_libs_user, mustWork = FALSE))
if (!(normalizePath(rlib, mustWork = FALSE) %in% default_libs)){
    say("NOTE: ", rlib, " is not one of R's default libraries. Make sure future R sessions can find it, e.g. by adding")
    say("      R_LIBS_USER=", rlib, "  to your ~/.Renviron")
}

##################################
## What needs to be installed   ##
##################################
parse_dep_field <- function(field){
    if (!(field %in% colnames(jamsdesc)) || is.na(jamsdesc[1, field])){
        return(character(0))
    }
    pkgs <- trimws(strsplit(gsub("\\s+", " ", jamsdesc[1, field]), ",")[[1]])
    pkgs <- trimws(sub("\\(.*\\)", "", pkgs))
    pkgs[nzchar(pkgs)]
}
base_pkgs <- c("R", rownames(installed.packages(priority = "base")), "parallel", "grid", "tools", "utils", "stats", "methods", "graphics", "grDevices", "splines", "stats4", "tcltk", "compiler")
required_pkgs <- setdiff(unique(c(parse_dep_field("Depends"), parse_dep_field("Imports"))), base_pkgs)
suggested_pkgs <- setdiff(parse_dep_field("Suggests"), base_pkgs)

#Optional packages that need special handling or only make sense in some profiles
full_only <- c("dada2", "DECIPHER")                           #JAMS16 (amplicon pipeline); Unix only in practice
optional_pkgs <- setdiff(suggested_pkgs, c(full_only, "BiocManager"))
if (profile == "minimal"){
    optional_pkgs <- character(0)
} else if (profile == "full"){
    optional_pkgs <- c(optional_pkgs, intersect(full_only, suggested_pkgs))
}

say("Required R packages (", length(required_pkgs), "): ", paste(required_pkgs, collapse = ", "))
say("Optional R packages (", length(optional_pkgs), "): ", ifelse(length(optional_pkgs) > 0, paste(optional_pkgs, collapse = ", "), "none"))

#####################################################
## Health check of what is already installed       ##
#####################################################
#Done before anything is installed (and in --dry-run). Uses only what is on disk, no network.
rscript <- file.path(R.home("bin"), ifelse(on_windows, "Rscript.exe", "Rscript"))
r_xy <- paste(R.version$major, strsplit(R.version$minor, ".", fixed = TRUE)[[1]][1], sep = ".")

#"R 4.5.1; x86_64-pc-linux-gnu; 2025-07-01 ...; unix" -> "4.5"
built_xy <- function(built){
    built <- as.character(built)
    out <- sub("^R ([0-9]+\\.[0-9]+).*$", "\\1", built)
    out[is.na(built) | (out == built)] <- NA
    out
}

#Installed packages as R sees them: the first copy found along .libPaths() is the one that gets loaded.
installed_first <- function(){
    ip <- installed.packages(lib.loc = .libPaths(), noCache = TRUE)
    ip <- ip[!duplicated(ip[, "Package"]), , drop = FALSE]
    rownames(ip) <- ip[, "Package"]
    ip
}

#Recursive hard dependencies (Depends, Imports, LinkingTo) of pkgs according to the package database db.
dependency_tree <- function(pkgs, db){
    deps <- tryCatch(tools::package_dependencies(pkgs, db = db, which = c("Depends", "Imports", "LinkingTo"), recursive = TRUE),
                     error = function(e) list())
    setdiff(unique(c(pkgs, unlist(deps, use.names = FALSE))), base_pkgs)
}

#Try to load each package in a FRESH R process (never in this one, where loading would lock in old versions).
#Returns a named character vector: "OK" or the error message.
check_loads <- function(pkgs, prepend_rlib = TRUE){
    res <- setNames(rep("could not be checked", length(pkgs)), pkgs)
    if (length(pkgs) == 0){
        return(res)
    }
    f <- tempfile(fileext = ".R")
    writeLines(c(if (prepend_rlib) paste0(".libPaths(c(", deparse(rlib), ", .libPaths()))") else character(0),
                 paste0("pk <- ", paste(deparse(pkgs), collapse = " ")),
                 "for (p in pk){",
                 "    r <- tryCatch({ suppressWarnings(suppressPackageStartupMessages(loadNamespace(p))); 'OK' }, error = function(e) gsub('[[:space:]]+', ' ', conditionMessage(e)))",
                 "    cat('\\nJAMSCHECK', p, r, sep = '\\t'); cat('\\n')",
                 "}"), f)
    out <- tryCatch(suppressWarnings(system2(rscript, shQuote(f), stdout = TRUE, stderr = TRUE)), error = function(e) character(0))
    unlink(f)
    for (ln in grep("^JAMSCHECK\t", out, value = TRUE)){
        parts <- strsplit(ln, "\t", fixed = TRUE)[[1]]
        if ((length(parts) >= 3) && (parts[2] %in% pkgs)){
            res[parts[2]] <- paste(parts[-(1:2)], collapse = " ")
        }
    }
    res
}

same_path <- function(a, b){
    normalizePath(a, mustWork = FALSE) == normalizePath(b, mustWork = FALSE)
}

wanted_pkgs <- unique(c(required_pkgs, optional_pkgs))
ip_now <- installed_first()
tree_installed <- intersect(dependency_tree(wanted_pkgs, ip_now), rownames(ip_now))

#Packages that JAMS needs which were built under another R x.y. Compiled code is not portable between R minor
#versions (e.g. R 4.6 removed non-API entry points such as SETLENGTH that packages built for R 4.5 still call).
#Pure-R packages carry over between minor versions, so only compiled ones (or ones from another major R) count.
find_stale <- function(pkgs, ip){
    pkgs <- intersect(pkgs, rownames(ip))
    df <- data.frame(Package = pkgs,
                     Built = built_xy(ip[pkgs, "Built"]),
                     NeedsCompilation = unname(ip[pkgs, "NeedsCompilation"]),
                     LibPath = unname(ip[pkgs, "LibPath"]),
                     stringsAsFactors = FALSE)
    other_major <- !is.na(df$Built) & (sub("\\..*$", "", df$Built) != R.version$major)
    keep <- !is.na(df$Built) & (df$Built != r_xy) & ((df$NeedsCompilation %in% "yes") | other_major)
    df[keep, , drop = FALSE]
}
stale_df <- find_stale(tree_installed, ip_now)
stale_in_rlib <- stale_df$Package[same_path(stale_df$LibPath, rlib)]
stale_elsewhere <- setdiff(stale_df$Package, stale_in_rlib)
rebuild_stale <- !is.null(opts[["--rebuild-stale"]])

#Libraries that a NEW R session will search before rlib (so their copies would win over anything we install in rlib).
libs_before_rlib <- function(){
    pos <- which(same_path(orig_libpaths, rlib))
    if (length(pos) == 0) orig_libpaths else orig_libpaths[seq_len(pos[1] - 1)]
}

report_stale <- function(stale_df){
    rule(paste("Packages built for a different R version than R", r_xy))
    say(nrow(stale_df), " package(s) that JAMS needs were built under a different R version than the one running (R ", r_xy, ").")
    say("Packages must be rebuilt for each R x.y version, otherwise they fail to load with errors such as")
    say("'undefined symbol: SETLENGTH' or 'package ... was built under R version ...'.")
    for (lp in unique(stale_df$LibPath)){
        sub_df <- stale_df[stale_df$LibPath == lp, , drop = FALSE]
        say("  In ", lp, " (", nrow(sub_df), "): ", paste0(sub_df$Package, " [R ", sub_df$Built, "]", collapse = ", "))
    }
}

report_stale_elsewhere <- function(stale_df, stale_elsewhere){
    if (length(stale_elsewhere) > 0){
        say("Fresh copies of the ", length(stale_elsewhere), " package(s) outside ", rlib, " will be installed into ", rlib, " (the other libraries are not touched).")
        shadowing <- unique(stale_df$LibPath[stale_df$Package %in% stale_elsewhere])
        shadowing <- shadowing[normalizePath(shadowing, mustWork = FALSE) %in% normalizePath(libs_before_rlib(), mustWork = FALSE)]
        if (length(shadowing) > 0){
            say("WARNING: a new R session searches ", paste(shadowing, collapse = ", "), " BEFORE ", rlib, ",")
            say("         so the old copies would still be loaded. Remove that folder from R_LIBS / R_LIBS_USER (check ~/.bashrc,")
            say("         ~/.bash_profile and ~/.Renviron), or put ", rlib, " first.")
        }
    }
}

if (nrow(stale_df) > 0){
    report_stale(stale_df)
}

stale_library_advice <- function(){
    cat("\n")
    say("The library being installed into, ", rlib, ", holds packages built for another R version.")
    say("It is probably shared between R versions (look for R_LIBS or R_LIBS_USER in ~/.bashrc, ~/.bash_profile and ~/.Renviron).")
    say("Choose one of:")
    say("  A) Recommended: one library per R version. For example:")
    say("       mkdir -p ", file.path(dirname(rlib), paste0("R_", r_xy)))
    say("     then in ~/.Renviron set  R_LIBS_USER=", file.path(dirname(rlib), "R_%v"), "   (R replaces %v with ", r_xy, "),")
    say("     remove ", rlib, " from R_LIBS / R_LIBS_USER wherever it is set, open a new shell and run the installer again.")
    say("  B) Rebuild the packages listed above for R ", r_xy, " inside ", rlib, ": run the installer again with --rebuild-stale.")
    say("     Any other R version that still uses this library would then need its packages rebuilt in turn.")
}

#Never silently overwrite packages in a library that another R version may still be using.
stop_for_stale <- function(){
    stale_library_advice()
    if (interactive() || dry_run){
        if (dry_run) say("Dry run: nothing was installed.")
        if (interactive()) stop("Stopped before installing anything.", call. = FALSE) else quit(save = "no", status = 0)
    } else {
        quit(save = "no", status = 1)
    }
}
if ((length(stale_in_rlib) > 0) && !rebuild_stale){
    stop_for_stale()
}
report_stale_elsewhere(stale_df, stale_elsewhere)

if (dry_run){
    missing_req <- setdiff(required_pkgs, rownames(ip_now))
    missing_opt <- setdiff(optional_pkgs, rownames(ip_now))
    say("Dry run: ", length(missing_req), " required package(s) missing: ", ifelse(length(missing_req) > 0, paste(missing_req, collapse = ", "), "none"))
    say("Dry run: ", length(missing_opt), " optional package(s) missing: ", ifelse(length(missing_opt) > 0, paste(missing_opt, collapse = ", "), "none"))
    if (nrow(stale_df) > 0){
        say("Dry run: ", nrow(stale_df), " package(s) would be rebuilt for R ", r_xy, " into ", rlib, ".")
    }
    say("Dry run: nothing was installed.")
    if (interactive()) {
        stop("Dry run finished.", call. = FALSE)
    } else {
        quit(save = "no", status = 0)
    }
}

#####################################
## Network and installer settings  ##
#####################################
cran <- "https://cloud.r-project.org"
options(repos = c(CRAN = cran), timeout = max(600, getOption("timeout")))
#Use binary packages without prompting on macOS and Windows; only compile when no binary exists at all.
if (on_mac || on_windows){
    options(install.packages.compile.from.source = "never")
}
#Parallel compilation for source installs (Linux mostly). Inside a batch job, use the CPUs allocated to the job,
#not every core on the node (detectCores() reports the whole node).
alloc_cpus <- NA
for (cpuvar in c("SLURM_CPUS_PER_TASK", "SLURM_CPUS_ON_NODE", "PBS_NUM_PPN", "NCPUS", "NSLOTS", "LSB_DJOB_NUMPROC")){
    if (is.na(alloc_cpus) && nzchar(Sys.getenv(cpuvar))){
        alloc_cpus <- suppressWarnings(as.numeric(sub("^([0-9]+).*$", "\\1", Sys.getenv(cpuvar))))
    }
}
if (is.na(alloc_cpus)){
    alloc_cpus <- tryCatch(parallel::detectCores(), error = function(e) 1)
}
ncpus_build <- if (is.na(alloc_cpus)) 1 else max(1, min(8, alloc_cpus - 1))
options(Ncpus = ncpus_build)
say("Compiling with up to ", ncpus_build, " parallel jobs")

#Compilation scratch space. Package builds run in child processes that honour TMPDIR, so point it at node-local
#scratch when there is some (e.g. Biowulf's /lscratch/$SLURM_JOB_ID): faster, and avoids filling a small /tmp.
if (nzchar(Sys.getenv("SLURM_JOB_ID"))){
    lscratch <- file.path("/lscratch", Sys.getenv("SLURM_JOB_ID"))
    if (dir.exists(lscratch) && is_writable(lscratch)){
        Sys.setenv(TMPDIR = lscratch)
        say("Using ", lscratch, " as temporary build space")
    }
}

online <- tryCatch({ curlGetHeaders(cran, timeout = 20L); TRUE }, error = function(e) FALSE)
if (!online){
    stop(paste0("Cannot reach ", cran, ". JAMSinstaller needs internet access.\n",
                "On an HPC cluster, compute nodes are often offline: run the installer on a login node (or a node with internet access),\n",
                "or set the https_proxy environment variable if your site uses a proxy."))
}

#Hints shown if something fails to compile
system_library_hints <- function(){
    if (on_linux){
        osrel <- if (file.exists("/etc/os-release")) tolower(paste(readLines("/etc/os-release", warn = FALSE), collapse = " ")) else ""
        cat("\nSome packages had to be compiled from source and failed. This is nearly always a missing system library.\n")
        if (grepl("ubuntu|debian", osrel)){
            cat("On Ubuntu/Debian, ask your administrator (or use sudo) to run:\n")
            cat("  apt-get install -y build-essential gfortran cmake libcurl4-openssl-dev libssl-dev libpng-dev zlib1g-dev libbz2-dev liblzma-dev\n")
        } else if (grepl("rhel|centos|rocky|alma|fedora|red hat", osrel)){
            cat("On RedHat/Rocky/Alma/Fedora, ask your administrator (or use sudo) to run:\n")
            cat("  dnf install -y gcc gcc-c++ gcc-gfortran make cmake libcurl-devel openssl-devel libpng-devel zlib-devel bzip2-devel xz-devel\n")
        } else {
            cat("Needed: C/C++/Fortran compilers, cmake, and the development headers for libcurl, openssl, libpng, zlib, bzip2 and xz/lzma.\n")
        }
        cat("On an HPC cluster these are usually available as modules (e.g. 'module load cmake gcc') - check your site's documentation.\n")
    } else if (on_mac){
        cat("\nA package needed compiling from source and failed. Install Apple's command line tools with:  xcode-select --install\n")
        cat("and, if Fortran is mentioned in the error, the gfortran build recommended at https://mac.r-project.org/tools/\n")
    } else if (on_windows){
        cat("\nA package needed compiling from source and failed. Install the Rtools version matching your R from\n")
        cat("https://cran.r-project.org/bin/windows/Rtools/ and try again.\n")
    }
}

#############################################
## Bootstrap: BiocManager and remotes      ##
#############################################
rule("Bootstrapping BiocManager and remotes")
for (bootpkg in c("BiocManager", "remotes")){
    if (!requireNamespace(bootpkg, quietly = TRUE)){
        install.packages(bootpkg, lib = rlib)
    }
    if (!requireNamespace(bootpkg, quietly = TRUE)){
        stop(paste("Could not install", bootpkg, "from CRAN."))
    }
}

bioc_version <- opts[["--bioc-version"]]
#update = FALSE: BiocManager must never try to update every outdated package in every library (see below).
bioc_args <- list(ask = FALSE, update = FALSE, lib = rlib)
if (!is.null(bioc_version)){
    bioc_args$version <- bioc_version
}
#Let BiocManager tell us which Bioconductor release goes with this R (or validate the pinned one).
#A no-op install() makes BiocManager validate its release against this R. An old BiocVersion left in a library
#shared with an older R (e.g. Bioconductor 3.22 under R 4.6) makes every install fail; BiocManager's error then
#says which version to use, so install that BiocVersion into rlib and validate again.
validate_bioc <- function(){
    tryCatch({
        do.call(BiocManager::install, c(list(pkgs = character(0)), bioc_args))
        TRUE
    }, error = function(e) conditionMessage(e))
}
bioc_ok <- validate_bioc()
if (!isTRUE(bioc_ok) && is.null(bioc_version)){
    suggested <- regmatches(bioc_ok, regexpr("version = ['\"]?[0-9]+\\.[0-9]+", bioc_ok))
    if (length(suggested) == 1){
        right_version <- sub("^version = ['\"]?", "", suggested)
        say("BiocManager reports a Bioconductor release that does not match R ", r_xy, " (", bioc_ok, ").")
        say("Installing BiocVersion ", right_version, " into ", rlib, " to fix it.")
        tryCatch(BiocManager::install(version = right_version, ask = FALSE, update = FALSE, lib = rlib),
                 error = function(e) say("Could not install BiocVersion ", right_version, ": ", conditionMessage(e)))
        bioc_ok <- validate_bioc()
    }
}
if (isTRUE(bioc_ok)){
    say("Bioconductor release: ", as.character(BiocManager::version()))
} else {
    say("ERROR from BiocManager: ", bioc_ok)
    bioc_ok <- FALSE
}
if (!bioc_ok){
    stop(paste0("BiocManager could not set up a Bioconductor release for R ", getRversion(), ".\n",
                "If you used --bioc-version, remove it so BiocManager picks the release that matches your R.\n",
                "Each Bioconductor release supports exactly one R x.y version (e.g. Bioconductor 3.23 needs R 4.6)."))
}

#Now that the repositories are reachable, follow dependencies of packages that are not installed yet too, so a
#stale package deep in the tree is caught before installing anything rather than after.
avail_db <- tryCatch(available.packages(repos = BiocManager::repositories()), error = function(e) NULL)
if (!is.null(avail_db)){
    full_tree <- union(tree_installed, intersect(dependency_tree(wanted_pkgs, avail_db), rownames(ip_now)))
    extra_stale <- find_stale(setdiff(full_tree, c(tree_installed, stale_df$Package)), ip_now)
    if (nrow(extra_stale) > 0){
        report_stale(extra_stale)
        extra_in_rlib <- extra_stale$Package[same_path(extra_stale$LibPath, rlib)]
        if ((length(extra_in_rlib) > 0) && !rebuild_stale){
            stop_for_stale()
        }
        report_stale_elsewhere(extra_stale, setdiff(extra_stale$Package, extra_in_rlib))
        stale_df <- rbind(stale_df, extra_stale)
        stale_elsewhere <- union(stale_elsewhere, setdiff(extra_stale$Package, extra_in_rlib))
    }
    tree_installed <- full_tree
}

#Install pkgs (CRAN or Bioconductor) into rlib. force = TRUE reinstalls packages that are already there.
bioc_install <- function(pkgs, force = FALSE){
    pkgs <- unique(pkgs)
    if (length(pkgs) == 0){
        return(invisible(NULL))
    }
    tryCatch(do.call(BiocManager::install, c(list(pkgs = pkgs, force = force), bioc_args)),
             error = function(e) say("Installer reported: ", conditionMessage(e)))
    invisible(NULL)
}

#Packages named in load errors that installing (into rlib) would fix: too-old versions and missing packages.
fixable_from_errors <- function(msgs){
    msgs <- msgs[msgs != "OK"]
    hits_old <- regmatches(msgs, regexpr("namespace [^A-Za-z0-9]{1,3}[A-Za-z0-9.]+[^A-Za-z0-9.]{1,3} [0-9.-]+ is (already|being) loaded, but >= [0-9.-]+ is required", msgs))
    hits_missing <- regmatches(msgs, regexpr("there is no package called [^A-Za-z0-9]{1,3}[A-Za-z0-9.]+", msgs))
    hits_so <- regmatches(msgs, regexpr("/[A-Za-z0-9.]+/libs/[^/ ]+\\.(so|dylib)", msgs))
    pk <- c(sub("^namespace [^A-Za-z0-9]{1,3}([A-Za-z0-9.]+).*$", "\\1", hits_old),
            sub("^there is no package called [^A-Za-z0-9]{1,3}", "", hits_missing))
    #A shared object that will not load (built for another R) can be fixed by reinstalling into rlib, unless it lives
    #in rlib itself and the user has not allowed rebuilding there.
    so_pk <- sub("^/([A-Za-z0-9.]+)/libs/.*$", "\\1", hits_so)
    ip <- installed_first()
    so_pk <- so_pk[so_pk %in% rownames(ip)]
    so_pk <- so_pk[rebuild_stale | !same_path(ip[so_pk, "LibPath"], rlib)]
    unique(c(pk, so_pk))
}

#Explain load failures with the actual error, and only then guess at causes.
explain_failures <- function(results){
    bad <- results[results != "OK"]
    cat("\n")
    for (p in names(bad)){
        say("  ", p, ": ", substr(bad[[p]], 1, 400))
    }
    ip <- installed_first()
    not_installed <- setdiff(names(bad), rownames(ip))
    if (any(grepl("undefined symbol|symbol not found|built under R version|built before R", bad))){
        say("Some packages were built for another R version (see the 'undefined symbol' / 'built under R' messages above).")
        stale_library_advice()
    }
    if (any(grepl("cannot open shared object file", bad, fixed = TRUE))){
        say("A system library needed at run time is missing (see 'cannot open shared object file' above). On an HPC cluster,")
        say("load the module that provides it, or make sure no conda environment is active while installing.")
    }
    if (length(not_installed) > 0){
        say("Not installed at all (their compilation failed - scroll up to the first error for each): ", paste(not_installed, collapse = ", "))
        system_library_hints()
    }
}

#####################################
## Required dependencies           ##
#####################################
rule("Installing required dependencies")
ip_now <- installed_first()
missing_required <- setdiff(required_pkgs, rownames(ip_now))
to_rebuild <- if (rebuild_stale) stale_df$Package else stale_elsewhere

#Outdated packages are updated only inside JAMS's own dependency tree and only in rlib: updating the whole library
#(BiocManager's default) can mean rebuilding hundreds of unrelated packages, and shared site libraries are not ours to change.
outdated <- character(0)
if (update_old){
    rlib_pkgs <- tryCatch(installed.packages(lib.loc = rlib, noCache = TRUE), error = function(e) NULL)
    if (!is.null(rlib_pkgs) && (nrow(rlib_pkgs) > 0)){
        old <- tryCatch(old.packages(lib.loc = rlib, repos = BiocManager::repositories(), instPkgs = rlib_pkgs), error = function(e) NULL)
        if (!is.null(old)){
            in_rlib <- rownames(ip_now)[same_path(ip_now[, "LibPath"], rlib)]
            outdated <- intersect(intersect(rownames(old), tree_installed), in_rlib)
        }
    }
}

if (force_install){
    to_force <- unique(c(required_pkgs, to_rebuild, outdated))
} else {
    to_force <- unique(c(to_rebuild, outdated))
}
if (length(to_force) > 0){
    say("Rebuilding/updating ", length(to_force), " package(s) in ", rlib, ": ", paste(to_force, collapse = ", "))
    bioc_install(to_force, force = TRUE)
}
if (length(missing_required) > 0){
    say("Installing ", length(missing_required), " missing required package(s): ", paste(missing_required, collapse = ", "))
    bioc_install(missing_required, force = FALSE)
}
if ((length(to_force) == 0) && (length(missing_required) == 0)){
    say("All required packages are already installed.")
}

#Verify in a fresh R process, and fix what can be fixed automatically (up to two rounds).
say("Checking that every required package loads...")
req_results <- check_loads(required_pkgs)
for (fix_round in 1:2){
    if (all(req_results == "OK")){
        break
    }
    fixable <- setdiff(fixable_from_errors(req_results), base_pkgs)
    if (length(fixable) == 0){
        break
    }
    say("Load errors point at ", paste(fixable, collapse = ", "), "; installing current version(s) into ", rlib, " and checking again.")
    bioc_install(fixable, force = TRUE)
    req_results <- check_loads(required_pkgs)
}
if (any(req_results != "OK")){
    say("These required packages do not load:")
    explain_failures(req_results)
    stop("Required packages could not be installed or loaded (see the explanation above). Fix the problem and run the installer again; anything already installed is kept.", call. = FALSE)
}
say("All ", length(required_pkgs), " required packages load correctly.")

