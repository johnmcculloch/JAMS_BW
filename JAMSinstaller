if (length(optional_pkgs) > 0){
    rule("Installing optional dependencies")
    missing_optional <- if (force_install) optional_pkgs else setdiff(optional_pkgs, rownames(installed_first()))
    if (length(missing_optional) > 0){
        say("Installing ", length(missing_optional), " optional package(s): ", paste(missing_optional, collapse = ", "))
        bioc_install(missing_optional, force = force_install)
    } else {
        say("All optional packages are already installed.")
    }
    opt_results <- check_loads(optional_pkgs)
