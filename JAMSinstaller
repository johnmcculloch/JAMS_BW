rule("Installing JAMS")
#remotes::install_local records where JAMS was installed from (RemoteUrl), which JAMS uses to tell you when an update is available.
jams_ok <- tryCatch({
    remotes::install_local(jamsdir, dependencies = FALSE, upgrade = "never", force = TRUE, build = FALSE, lib = rlib)
    TRUE
}, error = function(e){
    say("remotes::install_local failed (", conditionMessage(e), "); trying install.packages instead.")
    tryCatch({
        install.packages(jamsdir, repos = NULL, type = "source", lib = rlib)
        TRUE
    }, error = function(e2) FALSE)
})

#Check JAMS loads in a fresh R process, exactly as a user (or JAMSalpha/JAMSbeta) would.
#The test code goes in a temporary file to avoid shell quoting differences between Windows and Unix.
#First exactly as a brand-new R session would (no library path tweaks), so that libraries searched before rlib
#(e.g. an old shared library in R_LIBS) cannot hide behind a passing test.
run_jams_check <- function(prepend_rlib){
    check_file <- tempfile(fileext = ".R")
    writeLines(c(if (prepend_rlib) paste0(".libPaths(c(", deparse(rlib), ", .libPaths()))") else character(0),
                 "options(JAMS.check_updates = FALSE)",
                 "suppressPackageStartupMessages(library(JAMS))",
                 "hw <- detectHardwareResources()",
                 "cat('JAMS', as.character(packageVersion('JAMS')), 'loaded OK from', dirname(find.package('JAMS')), '. Detected', hw[['threads']], 'CPUs and', round(hw[['memory']] / 1e9, 1), 'GB of RAM.', '\\n')"),
               check_file)
    tryCatch(suppressWarnings(system2(rscript, shQuote(check_file), stdout = TRUE, stderr = TRUE)), error = function(e) conditionMessage(e))
}
load_out <- run_jams_check(prepend_rlib = FALSE)
load_ok <- jams_ok && any(grepl("loaded OK", load_out, fixed = TRUE))
cat(paste(load_out, collapse = "\n"), "\n")
if (!load_ok && jams_ok){
    load_out2 <- run_jams_check(prepend_rlib = TRUE)
    if (any(grepl("loaded OK", load_out2, fixed = TRUE))){
        cat(paste(load_out2, collapse = "\n"), "\n")
        say("WARNING: JAMS is installed and works, but only when ", rlib, " is searched first. A new R session does not do that yet.")
        say("         Put  R_LIBS_USER=", rlib, "  in ~/.Renviron (and remove older libraries from R_LIBS), then open a new shell.")
        load_ok <- TRUE
    }
}
if (!load_ok){
    stop("JAMS was not installed correctly or does not load. See the messages above.")
}

#####################################
## Executables (Linux/macOS only)  ##
#####################################
binexecs <- c("JAMSalpha", "JAMSbeta", "JAMS16", "JAMSbuildk2db", "JAMSjoinlanes", "JAMSmakeswarm", "JAMSbankit", "JAMSfastqprefixrenamer")
if (!on_windows && is.null(opts[["--no-links"]])){
    rule("Linking JAMS executables")
    linkto <- opts[["--linkto"]]
    if (is.null(linkto)){
        linkto <- file.path(Sys.getenv("HOME"), "bin")
    }
    linkto <- path.expand(linkto)
    if (!dir.exists(linkto)){
        say("Creating ", linkto)
        dir.create(linkto, recursive = TRUE, showWarnings = FALSE)
    }
    jamsbinpath <- file.path(jamsdir, "libexec")
    for (binexec in binexecs){
        sourcepath <- file.path(jamsbinpath, binexec)
        targetpath <- file.path(linkto, binexec)
        if (!file.exists(sourcepath)){
            next
        }
        Sys.chmod(sourcepath, mode = "0755", use_umask = TRUE)
        current_target <- Sys.readlink(targetpath)
        if (identical(normalizePath(current_target, mustWork = FALSE), normalizePath(sourcepath, mustWork = FALSE))){
            say(targetpath, " already points to this JAMS")
        } else if (file.exists(targetpath) || nzchar(current_target)){
            if (force_install && nzchar(current_target)){
                file.remove(targetpath)
                file.symlink(sourcepath, targetpath)
                say("Re-linked ", targetpath, " -> ", sourcepath)
            } else {
                say(targetpath, " already exists and points elsewhere (", ifelse(nzchar(current_target), current_target, "regular file"), "); left untouched. Use --force to re-link symbolic links.")
            }
        } else {
            file.symlink(sourcepath, targetpath)
            say("Linked ", targetpath, " -> ", sourcepath)
        }
    }
    path_dirs <- normalizePath(strsplit(Sys.getenv("PATH"), .Platform$path.sep)[[1]], mustWork = FALSE)
    if (!(normalizePath(linkto, mustWork = FALSE) %in% path_dirs)){
        say("NOTE: ", linkto, " is not in your PATH. Add this line to your ~/.bashrc or ~/.zshrc:")
        say("      export PATH=\"", linkto, ":$PATH\"")
    }
}

