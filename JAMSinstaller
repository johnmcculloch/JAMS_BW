    say("      will be single-threaded and slow. Install pigz (HPC: 'module load pigz'; macOS: 'brew install pigz';")
    say("      Ubuntu/Debian: 'apt install pigz'; RedHat: 'dnf install pigz'; conda: 'conda install -c conda-forge pigz').")
